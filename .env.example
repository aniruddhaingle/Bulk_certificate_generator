# Application
ENV=development
LOG_LEVEL=INFO

# PostgreSQL connection used by the API/Alembic.
# Inside Docker Compose, the host is the service name "postgres".
# Running the API directly on your machine, use "localhost" instead.
DATABASE_URL=postgresql+psycopg://certuser:certpassword@postgres:5432/certificates

# Redis / Celery (service is started by Docker Compose now; wired up in a later phase)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Business rules
MAX_BULK_SIZE=500

# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*

# Local filesystem storage root for generated certificates
STORAGE_DIR=storage

# Values Postgres container itself reads to initialize the database
POSTGRES_USER=certuser
POSTGRES_PASSWORD=certpassword
POSTGRES_DB=certificates
